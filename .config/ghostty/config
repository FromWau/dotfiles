# https://ghostty.org/docs/config/reference

## SHELL
command = /usr/bin/fish
working-directory = home
window-inherit-working-directory = false

## FONT
font-family = "FiraCode Nerd Font"
font-size = 11

## WINDOW DECORATION
window-decoration = none

## PADDING
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-padding-color = extend

## MOUSE
# G502 X emits ~8 hi-res events per detent; Ghostty counts each as a full
# wheel click, so the default discrete:3 scrolls ~24 lines/notch.
# 0.375 * 8 restores 3 lines/notch. Retune if the mouse changes.
mouse-scroll-multiplier = discrete:0.375

## QoL
copy-on-select = clipboard
link-url = true
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-autohide = true
confirm-close-surface = false
quit-after-last-window-closed = false
gtk-single-instance = true

## NOTIFICATIONS
app-notifications = no-config-reload,no-clipboard-copy

## THEME
theme = matugen

## Source Bindings
config-file = keybindings

