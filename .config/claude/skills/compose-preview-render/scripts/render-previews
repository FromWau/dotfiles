#!/usr/bin/env bash
# Render Compose preview fixtures to PNGs, headlessly, with zero repo changes.
# Part of the compose-preview-render skill — see its SKILL.md for the workflow.
#
# Required env:
#   PREVIEW_MODULE    Gradle path of the module (e.g. ":ui:other")
#   PREVIEW_FIXTURES  directory containing fixture .kt files
# Optional env:
#   PREVIEW_PROJECT_DIR  dir containing gradlew (default: current dir)
#   PREVIEW_OUT          output dir (default: /tmp/compose-previews)
#   PREVIEW_VARIANT      build variant, capitalized (default: Debug)
#   PREVIEW_BOM          compose BOM coordinate for the fixture classpath
#   PREVIEW_DEPS         extra screenshotTest deps (see init script header)
#   JAVA_HOME            must be a JDK 17+
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="${PREVIEW_PROJECT_DIR:-$PWD}"
OUT="${PREVIEW_OUT:-/tmp/compose-previews}"
VARIANT="${PREVIEW_VARIANT:-Debug}"
MODULE="${PREVIEW_MODULE:?set PREVIEW_MODULE, e.g. :feature:checkout}"
: "${PREVIEW_FIXTURES:?set PREVIEW_FIXTURES to the fixtures directory}"

export PREVIEW_OUT="$OUT"
mkdir -p "$OUT"

if [[ ! -x "$PROJECT_DIR/gradlew" ]]; then
	echo "error: no gradlew in $PROJECT_DIR (set PREVIEW_PROJECT_DIR)" >&2
	exit 1
fi

cd "$PROJECT_DIR"
./gradlew \
	-I "$SCRIPT_DIR/init-preview-render.gradle" \
	-Pandroid.experimental.enableScreenshotTest=true \
	"${MODULE}:update${VARIANT}ScreenshotTest" "$@"

echo
echo "Rendered previews in $OUT:"
find "$OUT" -name '*.png' | sort
